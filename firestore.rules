rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated and accessing their own data
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User profile and all associated subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Accounts subcollection
      match /accounts/{accountId} {
        allow read, write: if isOwner(userId);
      }
      
      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }
      
      // Beneficiaries subcollection
      match /beneficiaries/{beneficiaryId} {
        allow read, write: if isOwner(userId);
      }
      
      // Bill Payments subcollection
      match /bills/{billId} {
        allow read, write: if isOwner(userId);
      }
      
      // Budget document
      match /budget/{budgetId} {
        allow read, write: if isOwner(userId);
      }

      // Account Statements subcollection
      match /statements/{statementId} {
        allow read, write: if isOwner(userId);
      }

      // In-app Notifications subcollection
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }

      // User Settings & Preferences
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // Catch-all recursive rule for any subcollection of this user
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
